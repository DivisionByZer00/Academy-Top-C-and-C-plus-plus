#include <iostream>
#include <memory>

class BatteryReserve
{
public:
    explicit BatteryReserve(int value)
        : value_{ std::make_unique<int>(value) }
    {
        std::cout << "Reserve acquired\n";
    }

    ~BatteryReserve()
    {
        std::cout << "Reserve released\n";
    }

    int value() const
    {
        return *value_;
    }

private:
    std::unique_ptr<int> value_;
};

int main()
{
    int input{ 0 };

    std::cout << "Reserve (0-100): ";
    std::cin >> input;

    if (input < 0 || input > 100) {
        std::cout << "Input error \n";
        return 1;
    }

    BatteryReserve reserve{ input };
    std::cout << "Value: " << reserve.value() << "%\n";

    return 0;
}
